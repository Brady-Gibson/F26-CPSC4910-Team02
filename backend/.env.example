# Copy to .env (never commit it) and fill in.
DB_HOST=your-instance.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=Team02_DB

# Signs the login cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# development | production   (production turns off /api/bootstrap and requires HTTPS cookies)
APP_ENV=development
